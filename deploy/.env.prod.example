# Copy to /opt/invoiceiq/.env on the server and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

DOMAIN=invoices.example.com
LETSENCRYPT_EMAIL=you@example.com

# Images: ghcr.io/<GHCR_OWNER>/invoiceiq-{api,extractor,nginx}:<IMAGE_TAG>
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
EXTRACTOR_SERVICE_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=invoiceiq

# gemini (free tier) | openai. Free-tier Gemini prompts may be used by Google to improve its
# products: switch to a paid key (LLM_BILLING_TIER=paid) before processing real invoices.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
EXTRACT_MODEL=gemini-3.5-flash-lite
REPAIR_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
LLM_BILLING_TIER=free
LLM_DAILY_BUDGET_USD=1
AUTO_APPROVE_THRESHOLD=0.9

WORKER_CONCURRENCY=1
AUDIT_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Used once by `scripts/deploy.sh --seed` to create the demo users.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_EMAIL=reviewer@example.com
SEED_REVIEWER_PASSWORD=
