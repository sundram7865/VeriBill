{
  "name": "invoiceiq",
  "private": true,
  "description": "InvoiceIQ: the LLM proposes, rules verify, humans handle the uncertain cases, and accuracy is measured.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export:eval": "pnpm --filter @invoiceiq/api export:eval",
    "seed": "docker compose exec api node dist/scripts/seed.js",
    "seed:samples": "pnpm --filter @invoiceiq/api seed:samples"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
