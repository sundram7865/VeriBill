{
  "$defs": {
    "FieldOut": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[x0, y0, x1, y1] as fractions of the page",
          "title": "Bbox"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "grounded": {
          "title": "Grounded",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/IssueOut"
          },
          "title": "Issues",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "path",
        "value",
        "confidence",
        "page",
        "bbox",
        "grounded",
        "issues"
      ],
      "title": "FieldOut",
      "type": "object"
    },
