# Copy to .env for local development: cp .env.example .env
# Never commit .env. Every value below is safe to share; real secrets go only in .env.

# ---- shared secrets (generate your own: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
EXTRACTOR_SERVICE_TOKEN=dev-only-service-token-change-me-0123456789

# ---- API ----
LOG_LEVEL=info
# local = files on disk (default, no credentials needed); cloudinary = private Cloudinary assets
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=invoiceiq-dev
WORKER_CONCURRENCY=1
AUDIT_SAMPLE_RATE=0.1

# ---- extractor / LLM ----
# live = call OpenAI; record = call OpenAI and save responses; replay = only use saved responses
LLM_MODE=live
OPENAI_API_KEY=
# Model ids are configuration, not code. Chosen default and reasoning: docs/DECISIONS.md (D-008).
EXTRACT_MODEL=gpt-6-luna
REPAIR_MODEL=gpt-6-luna
# Reasoning effort for reasoning models (none|low|medium|high). Empty = model default.
LLM_REASONING_EFFORT=low
# Hard daily spend cap counted in Redis; the extractor refuses new work once reached.
LLM_DAILY_BUDGET_USD=2
# Document confidence needed to auto-approve. Tune it on the eval dev split (docs/EVAL_REPORT.md).
AUTO_APPROVE_THRESHOLD=0.9

# ---- host ports for docker compose (change if they clash with something local) ----
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=4000
WEB_HOST_PORT=3000
